# syntax=docker/dockerfile:1
FROM node:26-alpine AS base
RUN corepack enable
WORKDIR /repo

FROM base AS dependencies
COPY pnpm-workspace.yaml pnpm-lock.yaml ./package.json ./turbo.json ./
COPY packages ./packages
RUN pnpm install --frozen-lockfile

FROM base AS builder
COPY --from=dependencies /repo/node_modules ./node_modules
COPY --from=dependencies /repo/packages ./packages
COPY --from=dependencies /repo/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=dependencies /repo/turbo.json ./turbo.json
COPY --from=dependencies /repo/package.json ./package.json
COPY packages/database ./packages/database
COPY services/api ./services/api
RUN npx prisma generate --schema packages/database/prisma/schema.prisma
RUN pnpm --filter @bbrains/api build

FROM node:26-alpine AS runner
WORKDIR /repo/services/api
ENV NODE_ENV=production
COPY --from=builder /repo/services/api/dist ./dist
COPY --from=builder /repo/node_modules ./node_modules
EXPOSE 4000
CMD ["node", "dist/main.js"]