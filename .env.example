# ============================================================
# BBrains environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# ---- General ----
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
WS_URL=ws://localhost:4000

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://bbrains:bbrains@localhost:5432/bbrains?schema=public

# ---- Cache & Queues (Redis / Valkey) ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Object Storage (MinIO, S3-compatible) ----
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bbrains
MINIO_REGION=us-east-1

# ---- Real-time / Media (LiveKit) ----
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# ---- AI Service (FastAPI) ----
AI_SERVICE_URL=http://localhost:5000
AI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AI_LLM_PROVIDER=ollama
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_OLLAMA_MODEL=llama3

# ---- Code Runner (Judge0) ----
CODE_RUNNER_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=change-me

# ---- Search (Meilisearch) ----
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=change-me

# ---- E-mail / Notifications ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# ---- Multi-tenancy / Licensing ----
LICENSE_SERVER_URL=https://api.bbrains.app
DEFAULT_LICENSE_TYPE=community

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=