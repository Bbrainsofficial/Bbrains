{
  "name": "@bbrains/realtime-media",
  "version": "0.1.0",
  "private": true,
  "description": "BBrains real-time media service — LiveKit integration for livestreams, voice/video calls, and screen sharing.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist node_modules"
  },
  "dependencies": {
    "livekit-server-sdk": "^2.9.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}