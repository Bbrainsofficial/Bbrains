# BBrains AI service environment
AI_SERVICE_PORT=5000
AI_LOG_LEVEL=INFO

# LLM provider: "ollama" (local/self-hosted) or "openai"
AI_LLM_PROVIDER=ollama
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_OLLAMA_MODEL=llama3
# AI_OPENAI_API_KEY=
# AI_OPENAI_MODEL=gpt-4o-mini

# Embeddings
AI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AI_EMBEDDING_DIM=384

# Vector database
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_COLLECTION=bbrains_documents
# For PGVector (Postgres) alternative use the DATABASE_URL below instead.
VECTOR_BACKEND=qdrant

# Auth shared with the API service (same JWT secret)
JWT_SECRET=change-me

# Core API service to fetch course/user context
API_SERVICE_URL=http://localhost:4000